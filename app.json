{
  "expo": {
    "name": "Wicki",
    "slug": "wick",
    "scheme": "wick",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.bahradine.wick",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": false
    },
    "android": {
      "package": "com.bahradine.wick",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#062018"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "backgroundColor": "#06150F",
          "dark": {
            "backgroundColor": "#06150F"
          }
        }
      ],
      "expo-status-bar",
      "./plugins/no-push"
    ],
    "owner": "theboss4",
    "extra": {
      "eas": {
        "projectId": "370b232e-94c1-4f54-9706-755165ac5c84"
      },
      "appleSignIn": false
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/370b232e-94c1-4f54-9706-755165ac5c84"
    }
  }
}
